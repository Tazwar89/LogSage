# Shared base image for services that need vector search (ingestion_service,
# analysis_service). Installs uv + logsage_common[vector] once -- this is
# the expensive layer (~700MB+ for torch/sentence-transformers), so it's
# built once here instead of independently per service.
#
# consumer_service does NOT extend this image -- it installs logsage_common
# WITHOUT the [vector] extra directly in its own Dockerfile, skipping this
# entire dependency chain since it never touches VectorStore.
#
# Build once, tag it, then each vector-needing service's Dockerfile does:
#   FROM logsage-base:latest
#
# Rebuild only when libs/logsage_common changes:
#   docker build -f Dockerfile.base -t logsage-base:latest .
FROM --platform=$BUILDPLATFORM python:3.11-slim
WORKDIR /app

RUN pip install --no-cache-dir uv

ENV PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cpu"
ENV UV_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cpu"

COPY libs/logsage_common /app/libs/logsage_common
RUN uv pip install --system --no-cache -e "/app/libs/logsage_common[vector]"